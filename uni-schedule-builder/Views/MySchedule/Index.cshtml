@model MyScheduleViewModel

@{
    ViewData["Title"] = "My Personal Schedule";
    ViewData["Exceptions"] = Model.ExceptionsByTerm;
    ViewData["ScheduleIdsByTerm"] = Model.Entries.ToDictionary(e => e.RegularClassTermId, e => e.Id);
    ViewData["EmptyText"] = "You haven't added any classes yet. Browse the Full Schedule and use the Add button to build your personal schedule.";
}

<div class="page-title">
    <span class="title-accent"></span>
    <span class="title-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M8 15h.01"/><path d="M16 15h.01"/><path d="M12 15h.01"/><path d="M3 3h18v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3z"/></svg>
    </span>
    <span>@ViewData["Title"]</span>
</div>
<p class="page-subtitle">
    Your selected classes. Cards with a colored badge have an active exception posted by the teacher.
</p>

@await Html.PartialAsync("_Timetable", (IEnumerable<RegularClassTerm>)Model.Entries.Select(e => e.RegularClassTerm))