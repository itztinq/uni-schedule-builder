@{
    ViewData["Title"] = "Home";
}

<div class="row g-4 py-4">
    <div class="col-lg-8">
        <div class="dash-card">
            <div class="dash-card-body">
                <h1 class="hero-title">Welcome to <span class="accent">UniSchedule Builder</span></h1>
                <p class="text-muted mb-4" style="max-width:640px;">
                    A central weekly timetable for the faculty. Browse the full schedule, build your personal
                    timetable, and stay informed about class exceptions in real time.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Student"))
                        {
                            <a asp-controller="Schedule" asp-action="Index" class="btn btn-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                Browse Full Schedule
                            </a>
                            <a asp-controller="MySchedule" asp-action="Index" class="btn btn-outline-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M8 15h.01"/><path d="M16 15h.01"/><path d="M12 15h.01"/><path d="M3 3h18v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3z"/></svg>
                                My Schedule
                            </a>
                        }
                        @if (User.IsInRole("Teacher"))
                        {
                            <a asp-controller="TeacherExceptions" asp-action="Index" class="btn btn-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                My Classes / Exceptions
                            </a>
                            <a asp-controller="Schedule" asp-action="Index" class="btn btn-outline-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                Full Schedule
                            </a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="AdminDashboard" asp-action="Index" class="btn btn-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                                Dashboard
                            </a>
                            <a asp-controller="AdminSubjects" asp-action="Index" class="btn btn-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                                Manage Subjects
                            </a>
                            <a asp-controller="AdminRooms" asp-action="Index" class="btn btn-outline-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="22" x2="12" y2="2"/><path d="M5 2h14a1 1 0 0 1 1 1v2H4V3a1 1 0 0 1 1-1z"/><path d="M4 4v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4"/><line x1="8" y1="6" x2="8" y2="8"/><line x1="12" y1="6" x2="12" y2="8"/><line x1="16" y1="6" x2="16" y2="8"/></svg>
                                Manage Rooms
                            </a>
                        }
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                            Log In
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="dash-card h-100">
            <div class="dash-card-body">
                <h2 class="fs-6 fw-bold text-muted text-uppercase mb-3" style="letter-spacing:.05em;">About</h2>
                <ul class="list-unstyled d-flex flex-column gap-3 mb-0">
                    <li class="d-flex gap-3 align-items-start">
                        <span class="title-icon" style="width:30px;height:30px;">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:1rem;height:1rem;"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        </span>
                        <div>
                            <div class="fw-semibold">Weekly timetable</div>
                            <div class="text-muted small">Mon–Fri grid with hour slots and class cards.</div>
                        </div>
                    </li>
                    <li class="d-flex gap-3 align-items-start">
                        <span class="title-icon" style="width:30px;height:30px;">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:1rem;height:1rem;"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M8 15h.01"/><path d="M16 15h.01"/><path d="M12 15h.01"/><path d="M3 3h18v12a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3z"/></svg>
                        </span>
                        <div>
                            <div class="fw-semibold">Personal schedule</div>
                            <div class="text-muted small">Students build their own selection from the full schedule.</div>
                        </div>
                    </li>
                    <li class="d-flex gap-3 align-items-start">
                        <span class="title-icon" style="width:30px;height:30px;">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:1rem;height:1rem;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        </span>
                        <div>
                            <div class="fw-semibold">Class exceptions</div>
                            <div class="text-muted small">Teachers post cancellations, relocations and notes.</div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>