@model AdminTermViewModel

@{
    ViewData["Title"] = "Edit Term";
}

<div class="page-title">
    <span class="title-accent"></span>
    <span class="title-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/></svg>
    </span>
    <span>@ViewData["Title"]</span>
</div>

<div class="dash-card form-card">
    <div class="dash-card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id">
            <input type="hidden" asp-for="Id"/>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="DayOfWeek" class="form-label"></label>
                    <select asp-for="DayOfWeek" asp-items="Model.DayOptions" class="form-select"></select>
                    <span asp-validation-for="DayOfWeek" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="StartTime" class="form-label"></label>
                    <input asp-for="StartTime" class="form-control" type="time"/>
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EndTime" class="form-label"></label>
                    <input asp-for="EndTime" class="form-control" type="time"/>
                    <span asp-validation-for="EndTime" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="TermType" class="form-label"></label>
                    <select asp-for="TermType" asp-items="Model.TermTypeOptions" class="form-select"></select>
                    <span asp-validation-for="TermType" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="SubjectId" class="form-label"></label>
                    <select asp-for="SubjectId" asp-items="Model.SubjectOptions" class="form-select"></select>
                    <span asp-validation-for="SubjectId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="RoomId" class="form-label"></label>
                    <select asp-for="RoomId" asp-items="Model.RoomOptions" class="form-select"></select>
                    <span asp-validation-for="RoomId" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="TeacherId" class="form-label"></label>
                    <select asp-for="TeacherId" asp-items="Model.TeacherOptions" class="form-select"></select>
                    <span asp-validation-for="TeacherId" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label class="form-label">Groups</label>
                    <div class="grp-picker">
                        @foreach (var g in Model.Groups)
                        {
                            <label class="form-check form-check-inline">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="SelectedGroupIds"
                                       value="@g.Id"
                                       checked="@Model.SelectedGroupIds.Contains(g.Id)"/>
                                <span class="form-check-label">@g.Name</span>
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    Save
                </button>
                <a asp-controller="Schedule" asp-action="Index" class="btn btn-outline-secondary">Back to Schedule</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}