@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="dash-card" style="max-width:820px; margin:2rem auto 0;">
    <div class="dash-card-body">
        <h1 class="fs-3 fw-bold text-danger d-inline-flex align-items-center gap-2">
            <span class="title-icon" style="background:var(--dash-danger-soft); color:var(--dash-danger);">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </span>
            Error
        </h1>
        <h2 class="fs-5 text-danger">An error occurred while processing your request.</h2>

        @if (Model.ShowRequestId)
        {
            <p>
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <h3 class="fs-6 fw-bold text-muted text-uppercase mt-4" style="letter-spacing:.05em;">Development Mode</h3>
        <p class="text-muted mb-0">
            Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
        </p>
    </div>
</div>